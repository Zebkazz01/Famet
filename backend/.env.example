# Base de datos PostgreSQL — ajusta usuario, password y nombre de BD
DATABASE_URL="postgresql://postgres:CHANGEME_PASSWORD@localhost:5432/fameat_pos"

# JWT — CAMBIA en producción a cadena aleatoria larga
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Puerto HTTP del backend (también sirve el frontend en prod)
PORT=3001

# Balanza serial — déjalo en blanco si no hay balanza
SCALE_PORT="COM3"
SCALE_BAUD_RATE=9600

# Datos default del negocio (editables luego desde Configuración)
BUSINESS_NAME="ByteGest"
BUSINESS_ADDRESS=""
BUSINESS_PHONE=""

# Producción: poner "false" para NO servir el frontend desde Express
# (útil si lo sirves con otro servidor). Default: sí lo sirve.
# SERVE_FRONTEND=true

# Override ruta del frontend build. Default: ../frontend/dist
# FRONTEND_DIST=/ruta/absoluta/al/dist

# === Backups automáticos PostgreSQL ===
# BACKUP_ENABLED=true            # "false" para deshabilitar
# BACKUP_DIR=./backups           # directorio destino (default: backend/backups)
# BACKUP_RETENTION=14            # días a conservar
# BACKUP_CRON="0 2 * * *"        # cron expression (default: 02:00 diario)
# Requiere pg_dump en PATH (instalado con PostgreSQL).
