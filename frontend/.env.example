# Frontend Environment Variables

# API Backend URL
# En desarrollo: Vite usa proxy a localhost:3001 (ver vite.config.ts)
# En producción (Vercel): URL del backend desplegado
VITE_API_URL=/api

# Socket.IO URL (opcional, para producción)
# Si el backend está en otro dominio, configurar aquí
# VITE_SOCKET_URL=https://fameat-backend.up.railway.app

# NOTA: En Vercel, estas variables se configuran en el Dashboard
# Settings → Environment Variables
