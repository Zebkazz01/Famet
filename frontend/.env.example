# Frontend Environment Variables

# API Backend URL
# En desarrollo: Vite usa proxy a localhost:3001 (ver vite.config.ts)
# En producción (Vercel): usa mock API local (ver /api folder)
VITE_API_URL=/api

# Modo Demo
# Cuando VITE_API_URL=/api, usa datos mock estáticos
# Cuando VITE_API_URL=https://backend-real.com, usa backend real
VITE_DEMO_MODE=true

# Socket.IO URL (opcional, para producción con backend real)
# VITE_SOCKET_URL=https://fameat-backend.up.railway.app
